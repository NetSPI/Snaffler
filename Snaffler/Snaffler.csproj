<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Basic project settings -->
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>Snaffler</RootNamespace>
  </PropertyGroup>

  <!-- Conditional OutputType based on target framework -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Snaffler</AssemblyName>
    <LangVersion>10</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    
    <!-- Assembly metadata (moved from AssemblyInfo.cs) -->
    <AssemblyTitle>Snaffler</AssemblyTitle>
    <AssemblyDescription>A tool for quickly finding delicious candy needles in a haystack of network shares</AssemblyDescription>
    <AssemblyCompany>SnaffCon</AssemblyCompany>
    <AssemblyProduct>Snaffler</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2025</AssemblyCopyright>
    <AssemblyVersion>1.0.213.0</AssemblyVersion>
    <FileVersion>1.0.213.0</FileVersion>
    <ComVisible>false</ComVisible>
    <Guid>2aa060b4-de88-4d2a-a26a-760c1cefec3e</Guid>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Snaffler</PackageId>
    <PackageVersion>1.0.213</PackageVersion>
    <Title>Snaffler</Title>
    <Description>A tool for quickly finding delicious candy needles in a haystack of network shares. Snaffler is designed to help red teams and security professionals identify sensitive files and data across network shares during penetration testing and security assessments.</Description>
    <Authors>@l0ss and @Sh3r4</Authors>
    <Company>SnaffCon</Company>
    <Product>Snaffler</Product>
    <Copyright>Copyright © 2025</Copyright>
    <PackageTags>security;penetration testing;redteam;file discovery;network shares;infosec;sensitive data;discovery</PackageTags>
    <PackageProjectUrl>https://github.com/SnaffCon/Snaffler</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SnaffCon/Snaffler</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Initial release of Snaffler - a tool for finding sensitive files on network shares.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Application Icon -->
    <ApplicationIcon>Snaffler.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Framework references -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\SnaffCore\SnaffCore.csproj" />
  </ItemGroup>

  <!-- Package references -->
  <ItemGroup>
    <PackageReference Include="CommandLineArgumentsParser" Version="3.0.22" />
    <PackageReference Include="dnMerge" Version="0.5.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Nett" Version="0.15.0" />
    <PackageReference Include="NLog" Version="4.7.15" />
  </ItemGroup>

  <!-- Embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="SnaffRules\DefaultRules\**\*.toml" />
  </ItemGroup>
  
  <!-- Resource files (handled automatically by SDK) -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Content files -->
  <ItemGroup>
    <None Include="app.config" />
    <Content Include="Snaffler.ico" />
  </ItemGroup>

  <!-- Exclude AssemblyInfo.cs since we're using project properties -->
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>